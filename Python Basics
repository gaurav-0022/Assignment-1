"""
A function is a block of code that performs a specific task.

Why useful:
- Reusability
- Reduces code duplication
- Improves readability
"""

# -------------------------------
# Question 4:
# Program to take user's name and print greeting
# -------------------------------

name = input("Enter your name: ")
print("Hello,", name, "! Welcome!")

# -------------------------------
# Question 5:
# Check whether a number is even or odd
# -------------------------------

num = int(input("Enter a number: "))

if num % 2 == 0:
    print("Even number")
else:
    print("Odd number")

# -------------------------------
# Question 6:
# Print numbers from 1 to 10 using loop
# -------------------------------

for i in range(1, 11):
    print(i)

# -------------------------------
# Question 7:
# Find maximum number in a list
# -------------------------------

numbers = [10, 25, 5, 40, 15]
print("Maximum number:", max(numbers))

# -------------------------------
# Question 8:
# Remove duplicates from a list using set
# -------------------------------

list_with_duplicates = [1, 2, 2, 3, 4, 4, 5]
unique_list = list(set(list_with_duplicates))

print("List without duplicates:", unique_list)

# -------------------------------
# Question 9:
# Function to return square of a number
# -------------------------------

def square(n):
    return n * n

print("Square:", square(5))

# -------------------------------
# Question 10:
# Count how many times a number appears in a list
# -------------------------------

example_list = [2, 3, 4, 2, 5, 2]
number_to_count = 2

count = example_list.count(number_to_count)

print("Number of times", number_to_count, "appears:", count)
